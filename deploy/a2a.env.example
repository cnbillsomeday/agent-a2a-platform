# /etc/a2a/a2a.env —— systemd EnvironmentFile
# 复制为 /etc/a2a/a2a.env 并按实际改值（install.sh 会自动生成）

# 公网域名：did:web 的根，必须是 https 可达
A2A_DOMAIN=a2a.example.com

# 监听地址：默认只绑回环，由反向代理对外
A2A_ADDR=127.0.0.1:21220

# 状态目录：allowlist.json / tokens.json / tokens.txt / keys.json / agent_keys.json / data.json
A2A_DIR=/var/lib/a2a

# 消息保留时长（过期自动清理）
A2A_RETENTION=24h

# 消息签名模式：off | warn | strict
#   warn   = 有签必验，失败只记录（迁移期）
#   strict = 无签/验签失败一律 403（全员 register 公钥后切换）
A2A_SIGN_MODE=warn

# 防重放 nonce 缓存时长（应大于签名时间窗 ±300s）
A2A_NONCE_TTL=10m
